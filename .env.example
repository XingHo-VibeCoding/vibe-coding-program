# ==========================================================
#  .env.example —— 环境变量“示例”文件（唯一允许上传的此类文件）
#
#  用法：
#   1) 把本文件复制一份，改名为  .env
#   2) 在 .env 里填入**真实的** API Key / 密码
#   3) .env 已被 .gitignore 忽略，永远不会被上传到 GitHub
#
#  为什么要有这个文件：
#   它只写“变量名”和占位符，让别人知道项目需要哪些配置，
#   同时不含任何真实密钥 —— 这是业界标准做法。
# ==========================================================

# 示例：大模型 API Key（换成你自己的真实 Key 时，请写到 .env 里，不要改这里）
LLM_API_KEY=your_api_key_here

# 示例：数据库连接串
DATABASE_URL=postgresql://user:password@localhost:5432/mydb

# 示例：其他第三方服务密钥
THIRD_PARTY_SECRET=your_secret_here

# 示例：服务端口
PORT=3000
